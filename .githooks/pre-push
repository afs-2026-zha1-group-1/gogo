#!/usr/bin/env bash
# Blocks direct pushes to main so changes land through pull requests.
# Installed per clone by scripts/setup-dev.sh (core.hooksPath=.githooks).
#
# Escape hatch: ALLOW_MAIN_PUSH=1 git push ...
# This is a local guard, not a server policy: --no-verify skips it.

set -u

remote="${1:-group1}"
zero="0000000000000000000000000000000000000000"
blocked=0

[ "${ALLOW_MAIN_PUSH:-0}" = "1" ] && exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in
    refs/heads/main)
      echo "" >&2
      echo "pre-push: direct pushes to main are disabled." >&2
      echo "Push a branch and open a pull request instead:" >&2
      echo "  git push $remote HEAD:refs/heads/<your-branch>" >&2
      echo "Emergency override: ALLOW_MAIN_PUSH=1 git push ..." >&2
      blocked=1
      ;;
  esac
done

exit "$blocked"
